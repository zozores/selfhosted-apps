# ─────────────────────────────────────────────────────────────
# Environment variables for deploying It's a Plan on Dokploy.
# Paste these values into Dokploy's "Environment" tab (or copy to .env).
#
# Generate URL-safe secrets with:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

# ── Required: Database (PostgreSQL) ──
# Use URL-safe characters (e.g. openssl rand -hex 32) since it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32

# ── Required: Object Storage (RustFS / S3) ──
# Secret key must be at least 8 characters.
S3_ACCESS_KEY_ID=itsaplan
S3_SECRET_ACCESS_KEY=change-me-min-8-chars-use-openssl-rand-hex-32

# ── Required: Auth & Encryption Secrets ──
BETTER_AUTH_SECRET=change-me-use-openssl-rand-hex-32
# AES-256-GCM key used to encrypt stored AI/notification provider credentials.
# Never change this after storing credentials, or existing ones become undecryptable.
APP_ENCRYPTION_KEY=change-me-use-openssl-rand-hex-32

# ── Required: Public Origins (must match Dokploy Domains) ──
API_URL=https://api.itsaplan.example.com
APP_URL=https://itsaplan.example.com

# ── Optional: Image Version ──
# Pin a release tag (e.g. 0.10.1); unset defaults to latest.
# VERSION=latest

# ── Optional: PostgreSQL Overrides ──
# POSTGRES_USER=itsaplan
# POSTGRES_DB=itsaplan

# ── Optional: Pre-migration Database Backups ──
# BACKUP_RETENTION_DAYS=30
# SKIP_PRE_MIGRATION_BACKUP=1

# ── Optional: S3 / RustFS Overrides ──
# S3_BUCKET=planner-attachments
# S3_REGION=us-east-1
# Set to false for hosted S3 stores requiring virtual-host-style buckets (e.g. R2).
# S3_FORCE_PATH_STYLE=false

# ── Optional: Auth, Proxy, Webhooks & SSRF Policy ──
# Override parent domain derived from APP_URL (e.g. multi-label TLDs or deep subdomains).
# COOKIE_DOMAIN=.example.com
# Header used for client IP rate limiting; empty reads X-Forwarded-For.
# CLIENT_IP_HEADER=x-real-ip
# TRUSTED_PROXIES=10.0.0.5,172.18.0.0/16
# Public origin for incoming Git webhooks when API_URL is private.
# GIT_WEBHOOK_BASE_URL=https://hooks.example.com
# Comma-separated exact hostnames allowed even if they resolve to private IPs.
# SSRF_ALLOWED_HOSTS=git.internal.example.com

# ── Optional: Web Push Notifications (api + worker) ──
# Push stays disabled while any of the three is empty. Generate via `bun run web-push:keys`.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:admin@example.com

# ── Optional: Anonymous Telemetry (worker) ──
# TELEMETRY_DISABLED=1
# DO_NOT_TRACK=1
# TELEMETRY_DEBUG=1

# ── Optional: Legal Document URLs (web) ──
# Shown on logged-out screens; empty hides the notice.
# PRIVACY_URL=https://example.com/privacy
# TERMS_URL=https://example.com/terms
